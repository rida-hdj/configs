prefer-no-csd
input {
    keyboard {
        xkb {
            layout "us,ara"
            options "grp:win_space_toggle"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
        accel-speed 1
        accel-profile "flat"
    }
}
layout {
    struts {
        top 2
    }
    gaps 3
    center-focused-column "never"
    background-color "#1e1e2e"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width {
        proportion 0.5
    }
    focus-ring {
        on
        width 2
        active-color "#ffffff"
        inactive-color "#bcbcbc"
    }
    border {
        off
        width 1
        active-color "3D86FF"
        inactive-color "545454"
        urgent-color "#9b0000"
    }
    shadow {
        off
        softness 30
        spread 6
        offset x=0 y=0
        draw-behind-window true
        color "#000000"
    }
}
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
output "VGA-1" {
    mode "1280x1024@75.025"
    scale 1
}
/*
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    background-effect {
        blur false
    }
}
*/
animations {
    window-open {
        duration-ms 350
        curve "ease-out-expo"
        custom-shader "\n            vec4 open_color(vec3 coords_geo, vec3 size_geo) {\n                float offset = (1.0 - niri_clamped_progress) * 0.75;\n                vec3 shifted = coords_geo;\n                shifted.y -= offset;\n\n                if (shifted.y > 1.0)\n                    return vec4(0.0);\n\n                return texture2D(niri_tex, (niri_geo_to_tex * shifted).st);\n            }\n        "
    }
    window-close {
        off
    }
    slowdown 1
}
hotkey-overlay {
    skip-at-startup
}
window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
    default-column-width {

    }
}
window-rule {
    open-maximized true
}
layer-rule {
    match namespace="^noctalia-backdrop*"
    place-within-backdrop true
}
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    geometry-corner-radius 2
    clip-to-geometry true
}

spawn-at-startup "vicinae" "server"
include "./noctalia.kdl"
include "./binds.kdl"
// spawn-at-startup "noctalia-shell"
spawn-at-startup "noctalia"
// spawn-at-startup "npx" "arrpc"
