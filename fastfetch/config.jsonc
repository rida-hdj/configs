{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small",
        "height": 6,
        "width": 8,
        "padding": {
            "top": 1,
            "left": 2
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        "break",

        {
            "type": "host",
            "key": "PC      ",
            "keyColor": "\u001b[38;2;166;227;161m"
        },
        {
            "type": "custom",
            "key": "CPU     ",
            "keyColor": "\u001b[38;2;166;227;161m",
            "format": "i5-4570"
        },
        {
            "type": "custom",
            "key": "GPU     ",
            "keyColor": "\u001b[38;2;166;227;161m",
            "format": "Intel HD 4600"
        },
        {
            "type": "memory",
            "key": "RAM     ",
            "keyColor": "\u001b[38;2;166;227;161m"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;108;112;134m──────────────────────────────────────────────────\u001b[0m"
        },

        {
            "type": "os",
            "key": "OS      ",
            "keyColor": "\u001b[38;2;249;226;175m"
        },
        {
            "type": "kernel",
            "key": "Kernel  ",
            "keyColor": "\u001b[38;2;249;226;175m",
            "format": "{1}"
        },
        {
            "type": "shell",
            "key": "Shell   ",
            "keyColor": "\u001b[38;2;249;226;175m"
        },
        {
            "type": "terminal",
            "key": "Term    ",
            "keyColor": "\u001b[38;2;249;226;175m"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;108;112;134m──────────────────────────────────────────────────\u001b[0m"
        },

        {
            "type": "command",
            "key": "OS Age  ",
            "keyColor": "\u001b[38;2;137;180;250m",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "Uptime  ",
            "keyColor": "\u001b[38;2;137;180;250m"
        },

        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
